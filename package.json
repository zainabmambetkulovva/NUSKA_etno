{
  "name": "nuska-etno-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Premium Kyrgyz Ethno E-commerce Monorepo",

  "scripts": {
    "dev": "pnpm -r run dev",
    "dev:web": "pnpm --filter @nuska/web run dev",
    "dev:api": "pnpm --filter @nuska/api run dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @nuska/web run build",
    "build:api": "pnpm --filter @nuska/api run build",
    "test": "pnpm -r run test",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit --project apps/web/tsconfig.json",
    "typecheck:api": "tsc --noEmit --project apps/api/tsconfig.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @nuska/api run db:generate",
    "db:migrate": "pnpm --filter @nuska/api run db:migrate",
    "db:studio": "pnpm --filter @nuska/api run db:studio",
    "db:seed": "pnpm --filter @nuska/api run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.0.0"
}
