# Copy to apps/api/.env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Neon PostgreSQL. Use the pooled connection string for the app and the
# direct (non-pooled) connection string for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# JWT (generate with: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Password hashing
BCRYPT_ROUNDS=12

# Seed: passwords for the demo accounts created by `pnpm db:seed`.
# If empty, the seed generates random passwords and prints them once.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=
