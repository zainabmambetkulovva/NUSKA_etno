# Copy to apps/api/.env and fill in real values. Never commit .env.
# Full reference: docs/environment-variables.md

NODE_ENV=development
PORT=4000

# Frontend origin(s), comma-separated; WEB_URL is used in e-mail links
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000

# Neon PostgreSQL: pooled URL for the app, direct URL for migrations
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth (generate the secret with: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Cookies (COOKIE_SECURE defaults to true in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Apply pending migrations when the Docker image starts (Render free plan)
MIGRATE_ON_START=false
# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false
# Shared secret with the website proxy (API_PROXY_SECRET in apps/web). Required in production:
# requests without it are refused, and the real visitor IP is taken from the proxy.
PROXY_SECRET=
# Swagger UI at /api/docs (defaults to false in production)
SWAGGER_ENABLED=true

# E-mail (password reset, e-mail verification). Without SMTP_HOST mails are only logged (non-production).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="NUSKA_etno <no-reply@example.com>"

# S3-compatible storage for images (Supabase Storage, Cloudflare R2, AWS S3, MinIO...). Without it uploads return 503.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# Seed: SEED_DEMO=false loads only the catalog and site content (production).
SEED_DEMO=true
# Passwords for the demo accounts created by `pnpm db:seed`.
# If empty, the seed generates random passwords and prints them once.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=

# E2E tests only: a dedicated database whose name contains "test" (it is wiped by the tests)
TEST_DATABASE_URL=

# NUSKA AI (optional). Without ANTHROPIC_API_KEY the assistant works in catalog mode
# (no language model). The key is used only by the API and never sent to the browser.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
# AI_DAILY_LIMIT=300
