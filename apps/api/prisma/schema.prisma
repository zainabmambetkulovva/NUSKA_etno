// NUSKA_etno — Prisma schema
// Database: Neon PostgreSQL. Specification: DATABASE.md
//
// Conventions
// - Models / enums: PascalCase, enum values: UPPER_SNAKE_CASE, fields: camelCase.
// - Tables and columns: snake_case via @@map / @map.
// - Primary keys and foreign keys: UUID.
// - Money: integer amounts in tyiyn (1 som = 100 tyiyn), currency code next to it.
// - Locales: 'ky' (default) | 'ru' (enforced by CHECK constraints in the migration).
// - Orders, order items, payments and payment events are never deleted
//   physically, so their relations use onDelete: Restrict.
// - CHECK constraints and partial unique indexes that Prisma cannot express
//   are added in prisma/migrations/*_init/migration.sql (see the end of that file).

generator client {
  provider      = "prisma-client-js"
  // "native" for local development; debian-openssl-3.0.x for the production image (distroless Debian 12).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum UserRole {
  USER
  ADMIN
}

enum ProductType {
  FOOD
  BEVERAGE
}

/// Packaging shown in the interactive 3D viewer on the product page (TZ §6.4).
enum PackagingModel {
  BOTTLE
  JAR
  BOX
  PACK
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_READY
  ORDER_COMPLETED
  ORDER_CANCELLED
  GENERAL
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// PENDING: waiting for the e-mail confirmation (double opt-in).
enum NewsletterStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

// ============================================================================
// Users and authentication
// ============================================================================

model User {
  id              String    @id @default(uuid()) @db.Uuid
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  /// Stored lower-cased (normalised in the application layer).
  email           String    @unique
  /// Stored in E.164 format, e.g. +996XXXXXXXXX.
  phone           String?
  /// null for accounts created with Google sign-in (a password can be set via "forgot password").
  passwordHash    String?   @map("password_hash")
  /// Google account id ("sub") once the user has signed in with Google.
  googleId        String?   @unique @map("google_id") @db.VarChar(255)
  role            UserRole  @default(USER)
  /// Preferred interface language: 'ky' | 'ru'. Also used for notifications.
  locale          String    @default("ky") @db.VarChar(5)
  emailVerifiedAt DateTime? @map("email_verified_at")
  isActive        Boolean   @default(true) @map("is_active")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  cart                    Cart?
  favorites               Favorite[]
  giftSets                GiftSet[]
  orders                  Order[]
  orderStatusChanges      OrderStatusHistory[]
  reviews                 Review[]
  notifications           Notification[]
  stockMovements          StockMovement[]
  auditLogs               AuditLog[]

  @@index([phone])
  @@index([deletedAt])
  @@map("users")
}

/// Refresh-token sessions. Only a hash of the token is stored.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// ============================================================================
// Catalog
// ============================================================================

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  slug      String    @unique
  imageUrl  String?   @map("image_url")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     ProductCategory[]

  @@index([parentId])
  @@index([isActive, deletedAt, sortOrder])
  @@map("categories")
}

model CategoryTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  categoryId  String  @map("category_id") @db.Uuid
  locale      String  @db.VarChar(5)
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("category_translations")
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  sku            String          @unique
  slug           String          @unique
  type           ProductType     @default(FOOD)
  status         ProductStatus   @default(DRAFT)
  /// Price in tyiyn (1 som = 100 tyiyn).
  priceAmount    Int             @map("price_amount")
  currency       String          @default("KGS") @db.Char(3)
  /// Never negative (CHECK constraint). Changed only inside transactions.
  stockQuantity  Int             @default(0) @map("stock_quantity")
  /// When false, stock is not checked or deducted for this product.
  trackInventory Boolean         @default(true) @map("track_inventory")
  isFeatured     Boolean         @default(false) @map("is_featured")
  /// Interactive 3D packaging presentation; null = photo only.
  packaging3d    PackagingModel? @map("packaging_3d")
  sortOrder      Int             @default(0) @map("sort_order")
  deletedAt      DateTime?       @map("deleted_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  translations   ProductTranslation[]
  categories     ProductCategory[]
  images         ProductImage[]
  units          ProductUnit[]
  stockMovements StockMovement[]
  cartItems      CartItem[]
  favorites      Favorite[]
  giftSetItems   GiftSetItem[]
  orderItems     OrderItem[]
  reviews        Review[]

  @@index([status])
  @@index([deletedAt])
  @@index([isFeatured])
  @@index([status, deletedAt, sortOrder])
  @@map("products")
}

model ProductTranslation {
  id                  String  @id @default(uuid()) @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  locale              String  @db.VarChar(5)
  name                String
  shortDescription    String? @map("short_description")
  description         String?
  ingredients         String?
  /// "What is good about it": one benefit per line, shown as a list on the product page.
  benefits            String?
  storageInstructions String? @map("storage_instructions")
  /// Shelf life as the company states it (e.g. on the label).
  shelfLife           String? @map("shelf_life")
  /// Nutrition facts as on the label, one line per value.
  nutrition           String?
  /// Where the product comes from, only when the company has confirmed it.
  origin              String?
  /// Producer, only when verified by the company.
  producer            String?
  /// Product characteristics shown on the product page (TZ §6.4):
  /// an ordered array of { "name": string, "value": string } in this locale.
  characteristics     Json?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
  @@map("product_translations")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

/// Files live in S3-compatible storage; only the URL and metadata are stored here.
/// At most one primary image per product (partial unique index).
model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  url        String
  /// Object key in the storage bucket, needed to delete the file.
  storageKey String?  @map("storage_key")
  alt        String?
  mimeType   String?  @map("mime_type")
  sizeBytes  Int?     @map("size_bytes")
  width      Int?
  height     Int?
  sortOrder  Int      @default(0) @map("sort_order")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// Sale units (piece, pack, kg, l, g). Filled only with data provided by the company.
model ProductUnit {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  unitName      String   @map("unit_name")
  quantityValue Decimal  @map("quantity_value") @db.Decimal(10, 3)
  quantityUnit  String   @map("quantity_unit")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_units")
}

// ============================================================================
// Inventory
// ============================================================================

/// Stock ledger. `quantity` is a signed delta applied to Product.stockQuantity:
/// IN / RETURN > 0, OUT < 0, ADJUSTMENT either sign, never 0.
/// For order-related movements `referenceId` holds the order id.
model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  type        StockMovementType
  quantity    Int
  reason      String?
  referenceId String?           @map("reference_id")
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([referenceId])
  @@map("stock_movements")
}

// ============================================================================
// Cart and favorites
// ============================================================================

/// One cart per user. Guests keep the cart in the browser and it is merged on login.
model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  /// > 0 (CHECK constraint).
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("favorites")
}

// ============================================================================
// Pickup
// ============================================================================

/// Address, coordinates and hours are filled only with data from the company.
model PickupLocation {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  address      String
  description  String?
  phone        String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  openingHours String?  @map("opening_hours")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([isActive, sortOrder])
  @@map("pickup_locations")
}

// ============================================================================
// Orders
// ============================================================================

/// Orders are placed only by registered users (guest checkout is not supported).
/// Customer contacts and the pickup point are stored as a snapshot.
/// Stock is deducted when the order is created and returned when it is cancelled.
model Order {
  id                    String      @id @default(uuid()) @db.Uuid
  /// Human-readable sequential number shown to customers.
  orderNumber           Int         @unique @default(autoincrement()) @map("order_number")
  userId                String      @map("user_id") @db.Uuid
  status                OrderStatus @default(PENDING)
  /// Amounts in tyiyn, >= 0 (CHECK constraint).
  subtotalAmount        Int         @map("subtotal_amount")
  totalAmount           Int         @map("total_amount")
  currency              String      @default("KGS") @db.Char(3)
  /// Locale the order was placed in; used for notifications about it.
  locale                String      @default("ky") @db.VarChar(5)
  customerName          String      @map("customer_name")
  customerPhone         String      @map("customer_phone")
  customerEmail         String?     @map("customer_email")
  pickupLocationId      String      @map("pickup_location_id") @db.Uuid
  pickupLocationName    String      @map("pickup_location_name")
  pickupLocationAddress String      @map("pickup_location_address")
  pickupTime            DateTime?   @map("pickup_time")
  customerComment       String?     @map("customer_comment")
  confirmedAt           DateTime?   @map("confirmed_at")
  completedAt           DateTime?   @map("completed_at")
  cancelledAt           DateTime?   @map("cancelled_at")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  pickupLocation PickupLocation       @relation(fields: [pickupLocationId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  notifications  Notification[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([pickupLocationId])
  @@map("orders")
}

/// Snapshot of a product at the moment of ordering. Survives product
/// archiving, soft-deletion and price changes.
model OrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  productId        String?  @map("product_id") @db.Uuid
  productName      String   @map("product_name")
  productSku       String   @map("product_sku")
  /// > 0 (CHECK constraint).
  quantity         Int
  unitPriceAmount  Int      @map("unit_price_amount")
  totalPriceAmount Int      @map("total_price_amount")
  createdAt        DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  review  Review?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Every status change is recorded. `oldStatus` is null for the initial record.
model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  oldStatus   OrderStatus? @map("old_status")
  newStatus   OrderStatus  @map("new_status")
  changedById String?      @map("changed_by_id") @db.Uuid
  comment     String?
  createdAt   DateTime     @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ============================================================================
// Payments
// ============================================================================

/// An order may have several payment attempts. No card data is stored.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  /// Amount in tyiyn, >= 0 (CHECK constraint).
  amount            Int
  currency          String        @default("KGS") @db.Char(3)
  provider          String?
  providerPaymentId String?       @map("provider_payment_id")
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events PaymentEvent[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([providerPaymentId])
  @@map("payments")
}

/// Webhook / provider events. (provider, externalEventId) is unique, so the
/// same webhook can never be processed twice.
model PaymentEvent {
  id              String    @id @default(uuid()) @db.Uuid
  paymentId       String    @map("payment_id") @db.Uuid
  provider        String
  externalEventId String    @map("external_event_id")
  eventType       String    @map("event_type")
  payload         Json?
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, externalEventId])
  @@index([paymentId])
  @@map("payment_events")
}

// ============================================================================
// Reviews
// ============================================================================

/// A review can be left only for a purchased order item, once per item.
/// Rating 1..5 (CHECK constraint). Published after moderation.
model Review {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  productId   String       @map("product_id") @db.Uuid
  orderItemId String       @unique @map("order_item_id") @db.Uuid
  rating      Int
  comment     String?
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([productId, status])
  @@index([status])
  @@map("reviews")
}

// ============================================================================
// Notifications
// ============================================================================

/// Title and message are written in `locale` (the user's language at creation time).
model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType @default(GENERAL)
  locale         String           @default("ky") @db.VarChar(5)
  title          String
  message        String
  isRead         Boolean          @default(false) @map("is_read")
  relatedOrderId String?          @map("related_order_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedOrder Order? @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([relatedOrderId])
  @@map("notifications")
}

// ============================================================================
// Site content (admin-managed, TZ §14 "Управление контентом")
// ============================================================================

/// Home page banners.
model Banner {
  id        String    @id @default(uuid()) @db.Uuid
  imageUrl  String?   @map("image_url")
  linkUrl   String?   @map("link_url")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  translations BannerTranslation[]

  @@index([isActive, sortOrder])
  @@map("banners")
}

model BannerTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  bannerId    String  @map("banner_id") @db.Uuid
  locale      String  @db.VarChar(5)
  title       String
  subtitle    String?
  buttonLabel String? @map("button_label")

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([bannerId, locale])
  @@map("banner_translations")
}

/// Editable text blocks addressed by a stable key, e.g. "home.hero",
/// "home.about", "about", "contacts". `data` holds non-translatable values
/// (phone numbers, e-mail, social links) as JSON.
model SiteContent {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  data      Json?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations SiteContentTranslation[]

  @@map("site_content")
}

model SiteContentTranslation {
  id            String  @id @default(uuid()) @db.Uuid
  siteContentId String  @map("site_content_id") @db.Uuid
  locale        String  @db.VarChar(5)
  title         String?
  body          String?

  siteContent SiteContent @relation(fields: [siteContentId], references: [id], onDelete: Cascade)

  @@unique([siteContentId, locale])
  @@map("site_content_translations")
}

// ============================================================================
// Gift sets ("Build your own dastorkon")
// ============================================================================

/// A set of products saved by a user in the gift set builder. Prices are not
/// stored: the set is always priced from the current catalog.
model GiftSet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items GiftSetItem[]

  @@index([userId, createdAt])
  @@map("gift_sets")
}

/// quantity 1..99 (CHECK constraint).
model GiftSetItem {
  id        String @id @default(uuid()) @db.Uuid
  giftSetId String @map("gift_set_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int

  giftSet GiftSet @relation(fields: [giftSetId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([giftSetId, productId])
  @@index([productId])
  @@map("gift_set_items")
}

// ============================================================================
// FAQ and newsletter
// ============================================================================

/// FAQ entry edited in the admin panel. `category` groups the questions on the
/// FAQ page (orders, pickup, products, account, other).
model FaqItem {
  id        String   @id @default(uuid()) @db.Uuid
  category  String   @default("other") @db.VarChar(40)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations FaqItemTranslation[]

  @@index([isActive, category, sortOrder])
  @@map("faq_items")
}

model FaqItemTranslation {
  id        String @id @default(uuid()) @db.Uuid
  faqItemId String @map("faq_item_id") @db.Uuid
  locale    String @db.VarChar(5)
  question  String @db.VarChar(300)
  answer    String

  faqItem FaqItem @relation(fields: [faqItemId], references: [id], onDelete: Cascade)

  @@unique([faqItemId, locale])
  @@map("faq_item_translations")
}

/// Customer testimonials of the home page carousel, managed in the admin panel.
/// They are separate from product reviews (which need a delivered order).
/// `isDemo` marks sample entries: the site labels them until real ones replace them.
model Testimonial {
  id           String   @id @default(uuid()) @db.Uuid
  authorName   String   @map("author_name") @db.VarChar(80)
  text         String   @db.VarChar(1000)
  rating       Int      @default(5)
  reviewDate   DateTime @map("review_date") @db.Date
  photoUrl     String?  @map("photo_url")
  avatarUrl    String?  @map("avatar_url")
  productName  String?  @map("product_name") @db.VarChar(80)
  instagramUrl String?  @map("instagram_url")
  isPublished  Boolean  @default(true) @map("is_published")
  isDemo       Boolean  @default(false) @map("is_demo")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("testimonials")
}

/// Newsletter subscriber with explicit consent. The e-mail is stored lower-case.
/// Tokens are stored only as SHA-256 hashes.
model NewsletterSubscriber {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique @db.VarChar(254)
  locale           String           @default("ky") @db.VarChar(5)
  status           NewsletterStatus @default(PENDING)
  consentAt        DateTime         @map("consent_at")
  confirmTokenHash String?          @unique @map("confirm_token_hash") @db.VarChar(64)
  confirmSentAt    DateTime?        @map("confirm_sent_at")
  confirmedAt      DateTime?        @map("confirmed_at")
  unsubscribedAt   DateTime?        @map("unsubscribed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@map("newsletter_subscribers")
}

// ============================================================================
// Audit
// ============================================================================

/// Important admin actions: product create, price / stock change, order and
/// status changes, user management.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
