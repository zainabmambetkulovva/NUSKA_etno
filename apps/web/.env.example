# Copy to apps/web/.env.local.

# Where the Next.js server reaches the API (used for the /api proxy and server rendering)
API_INTERNAL_URL=http://localhost:4000

# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host of the S3 / CDN bucket that serves product images, e.g. cdn.nuska.kg
NEXT_PUBLIC_IMAGES_HOST=
